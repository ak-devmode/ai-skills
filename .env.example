# Environment overrides read by the ai-skills scripts. None is required — every one has a
# default. Declared here so scripts/resolve-identifiers.py (and a reader) can find them.

# Root that finish-table `repo` cells are relative to (scripts/verify_lib.py). Default ~/Projects.
VERIFY_PROJECTS=
# codex binary for scripts/codex-exec.py. Default: `codex` on PATH. Tests point it at fakes.
VERIFY_CODEX_BIN=
# Set to 1 to run the live-judge eval tier in scripts/tests (real codex calls, ~5 min).
VERIFY_EVAL=
VERIFY_CODEX_MODEL=sol   # codex model family (or exact slug), resolved from codex's model cache
CODEX_HOME=~/.codex      # codex home dir; its model cache lives here
# /review + /verify mode: unset = lean (one Sonnet pass); full = codex gate + full Claude fallback
AI_SKILLS_REVIEW_MODE=
# dev-workbench's per-machine accounts map, read by scripts/placement.py (/concurrency §5.1).
# Default ~/Projects/dev-workbench/config/accounts/accounts.tsv.
WORKBENCH_ACCOUNTS=
