# Environment overrides read by the ai-skills scripts. None is required — every one has a
# default. Declared here so scripts/resolve-identifiers.py (and a reader) can find them.

# Root that finish-table `repo` cells are relative to (scripts/verify_lib.py). Default ~/Projects.
VERIFY_PROJECTS=
# codex binary for scripts/codex-exec.py. Default: `codex` on PATH. Tests point it at fakes.
VERIFY_CODEX_BIN=
# Set to 1 to run the live-judge eval tier in scripts/tests (real codex calls, ~5 min).
VERIFY_EVAL=
VERIFY_CODEX_MODEL=sol   # codex model family (or exact slug), resolved from codex's model cache
CODEX_HOME=~/.codex      # codex home dir; its model cache lives here
# /review + /verify mode: unset = lean (one Sonnet pass); full = codex gate + full Claude fallback
AI_SKILLS_REVIEW_MODE=
# dev-workbench's per-machine accounts map, read by scripts/placement.py (/concurrency §5.1).
# Default ~/Projects/dev-workbench/config/accounts/accounts.tsv.
WORKBENCH_ACCOUNTS=
# Decision queue (scope 10, scripts/packet.py). Unset URL = packets stay in the lane outbox, no POST.
DECISION_QUEUE_URL=
# Demo tenant a UI packet's screenshots must come from (never a real-patient tenant). Unset = UI packets refused.
DQ_UI_DEMO_TENANT=
# packet.py identity overrides outside herdr (default: hostname / herdr ids / session id).
PACKET_MACHINE=
PACKET_WORKSPACE=
PACKET_AGENT=
# POST timeout in seconds for packet.py (tests only). Default 3; a bad value falls back to 3.
PACKET_POST_TIMEOUT=
# packet.py: outbox dir override (default .decision-queue/outbox in the repo).
PACKET_OUTBOX=
# Set by the platform, read by packet.py for lane identity — never set them by hand.
HERDR_AGENT_NAME=   # herdr: the pane's agent name
HERDR_WORKSPACE_ID= # herdr: workspace id of the calling pane
HERDR_PANE_ID=      # herdr: the calling pane's id (driver registration keys on it)
CLAUDE_CODE_SESSION_ID= # Claude Code session id (lane identity outside herdr)
CLAUDE_SESSION_ID=      # older Claude Code name for the same
CODEX_SESSION_ID=       # codex session id (lane identity outside herdr)
