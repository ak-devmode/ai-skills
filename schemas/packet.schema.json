{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.local/schemas/packet.schema.json",
  "title": "Decision-queue packet (scope 10, 10.1 task 1.1)",
  "$comment": "One packet = one decision from a lane. Root validates a packet; $defs/event validates a ticker event. Uses only keywords scripts/packet.py's stdlib validator implements: type, required, properties, additionalProperties, enum, const, pattern, minLength, minItems, minimum, items, contains/minContains/maxContains, allOf, if/then, $ref (local). Lane tag in reply: '[lane <machine>/<workspace>/<agent> <packet-id>]'; packet.py additionally checks the tag matches the packet's own fields and id (a pattern cannot back-reference). ui type is reserved for 10.4.",
  "type": "object",
  "required": ["schema_version", "id", "created_at", "machine", "workspace", "agent", "repo", "branch", "head_sha", "unit", "door", "type", "title", "options", "blocks", "continues_on", "payload", "reply"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "machine": {"$ref": "#/$defs/identity_part"},
    "workspace": {"$ref": "#/$defs/identity_part"},
    "agent": {"$ref": "#/$defs/identity_part"},
    "repo": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "unit": {"type": "string", "minLength": 1, "$comment": "scope/unit, e.g. 10/1.2"},
    "door": {"enum": ["one-way", "two-way", "info"]},
    "type": {"enum": ["data-model", "generic", "ui"]},
    "title": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "items": {"$ref": "#/$defs/option"}
    },
    "blocks": {"type": "string", "$comment": "what this decision blocks; empty string if nothing"},
    "continues_on": {"type": "string", "$comment": "what the lane does meanwhile (two-way work); empty string if parked"},
    "reversal_cost": {"$ref": "#/$defs/reversal_cost"},
    "payload": {"type": "object"},
    "reply": {"type": "string", "pattern": "^\\[lane [^/\\]\\[\\n]+/[^/\\]\\[\\n]+/[^/\\]\\[\\n]+ [A-Za-z0-9_-]{8,64}\\]"}
  },
  "allOf": [
    {
      "if": {"properties": {"door": {"enum": ["one-way", "two-way"]}}, "required": ["door"]},
      "then": {
        "properties": {
          "options": {
            "minItems": 1,
            "contains": {"properties": {"recommended": {"const": true}}, "required": ["recommended"]},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "data-model"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/payload_data_model"}}}
    },
    {
      "if": {"properties": {"type": {"const": "generic"}}, "required": ["type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/payload_generic"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$", "$comment": "client-generated; retries reuse it (idempotent)"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "identity_part": {"type": "string", "minLength": 1, "pattern": "^[^/\\]\\[\\n]+$", "$comment": "no '/', brackets or newline: it is embedded in the lane tag"},
    "option": {
      "type": "object",
      "required": ["id", "label", "recommended"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "recommended": {"type": "boolean"}
      }
    },
    "reversal_cost": {
      "type": "object",
      "required": ["commits_stacked", "as_of"],
      "additionalProperties": false,
      "properties": {
        "commits_stacked": {"type": "integer", "minimum": 0},
        "as_of": {"$ref": "#/$defs/timestamp"}
      }
    },
    "payload_generic": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {"body": {"type": "string", "minLength": 1, "$comment": "free markdown; the queue renders it sanitized"}}
    },
    "payload_data_model": {
      "type": "object",
      "required": ["tables"],
      "additionalProperties": false,
      "properties": {
        "tables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dm_table"}}
      }
    },
    "dm_table": {
      "type": "object",
      "required": ["name", "change", "columns"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "change": {"enum": ["added", "changed", "removed", "unchanged"]},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/dm_column"}}
      }
    },
    "dm_column": {
      "type": "object",
      "required": ["name", "changed"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "before": {"type": ["string", "null"], "$comment": "e.g. 'text not null'; null/absent = column did not exist"},
        "after": {"type": ["string", "null"], "$comment": "null/absent = column removed"},
        "changed": {"type": "boolean", "$comment": "the marker the ERD and before/after styles highlight"}
      }
    },
    "event": {
      "type": "object",
      "required": ["schema_version", "id", "kind", "created_at", "machine", "workspace", "agent", "body"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["done", "merged", "closed", "stale", "touch"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "machine": {"$ref": "#/$defs/identity_part"},
        "workspace": {"$ref": "#/$defs/identity_part"},
        "agent": {"$ref": "#/$defs/identity_part"},
        "packet_id": {"$ref": "#/$defs/id"},
        "body": {"type": "string"},
        "reversal_cost": {"$ref": "#/$defs/reversal_cost"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["closed", "stale", "touch"]}}, "required": ["kind"]},
          "then": {"required": ["packet_id"]}
        },
        {
          "if": {"properties": {"kind": {"const": "touch"}}, "required": ["kind"]},
          "then": {"required": ["reversal_cost"]}
        }
      ]
    }
  }
}
